{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApertureVersionConfig",
  "description": "Authoritative machine-readable single version source for Aperture products and release tooling",
  "type": "object",
  "required": [
    "major",
    "minor",
    "patch",
    "build",
    "version",
    "versionString",
    "displayVersion",
    "semVer",
    "companyName",
    "fileDescription",
    "fileVersion",
    "internalName",
    "legalCopyright",
    "originalFilename",
    "productName",
    "productVersion",
    "comments",
    "language",
    "codePage",
    "translation",
    "languageId",
    "codePageId"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "major": { "type": "integer", "minimum": 0 },
    "minor": { "type": "integer", "minimum": 0 },
    "patch": { "type": "integer", "minimum": 0 },
    "build": { "type": "integer", "minimum": 0 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "versionString": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "displayVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "semVer": { "type": "string" },
    "preRelease": { "type": "string" },
    "channel": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "companyName": { "type": "string", "minLength": 1 },
    "fileDescription": { "type": "string", "minLength": 1 },
    "fileVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "internalName": { "type": "string", "minLength": 1 },
    "legalCopyright": { "type": "string", "minLength": 1 },
    "originalFilename": { "type": "string", "minLength": 1 },
    "productName": { "type": "string", "minLength": 1 },
    "productVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "comments": { "type": "string" },
    "language": { "type": "string", "pattern": "^[0-9a-fA-F]{4}$" },
    "codePage": { "type": "string", "pattern": "^[0-9a-fA-F]{4}$" },
    "translation": { "type": "string", "pattern": "^[0-9a-fA-F]{8}$" },
    "languageId": { "type": "integer" },
    "codePageId": { "type": "integer" }
  },
  "additionalProperties": false
}
