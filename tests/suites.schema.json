{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApertureTestSuiteManifest",
  "description": "Schema for authoritative inventory of Aperture test suites and verification gates",
  "type": "object",
  "required": [
    "version",
    "validTiers",
    "validCategories",
    "suites"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "validTiers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "validCategories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "tier",
          "platform",
          "script",
          "prerequisites",
          "artifactPolicy",
          "timeoutSeconds",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifactPolicy": {
            "type": "string"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
