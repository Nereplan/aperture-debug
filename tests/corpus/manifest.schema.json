{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApertureCorpusManifest",
  "description": "Authoritative schema for Aperture parser and media container test corpus manifest",
  "type": "object",
  "required": [
    "version",
    "description",
    "categories",
    "fixtureCount",
    "fixtures"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "fixtureCount": {
      "type": "integer",
      "minimum": 1
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "path",
          "sha256",
          "sizeBytes",
          "expectedOutcome",
          "expectedReason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "category": {
            "type": "string",
            "enum": [
              "json",
              "playlist",
              "subtitle",
              "url",
              "command_line",
              "settings",
              "media"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^fixtures/[a-zA-Z0-9_/-]+\\.[a-zA-Z0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "expectedOutcome": {
            "type": "string",
            "enum": [
              "accept",
              "reject"
            ]
          },
          "expectedReason": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string"
          },
          "expectedFields": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
