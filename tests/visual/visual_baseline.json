    "version":  1,
    "description":  "Authoritative visual regression baselines, scene configurations, and comparison tolerances for Aperture native UI",
    "platform":  "windows-x64",
    "configuration":  "Release",
    "environment":  {
                        "dpi":  96.0,
                        "dpiScale":  1.0,
                        "theme":  "default",
