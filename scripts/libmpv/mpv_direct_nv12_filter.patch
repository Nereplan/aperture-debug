+// Evaluate the existing separable LUT as a 2D product directly on NV12.
+// Chroma is reconstructed at each luma-grid sample, preserving the original
+// bilinear-chroma -> RGB -> separable-filter operation without RGB FBOs.
+void pass_sample_nv12_2d(struct gl_shader_cache *sc, struct scaler *scaler,
+                         int y_tex, int uv_tex, int valid_w, int valid_h,
+                         float y_mul, float uv_mul)
+{
+    int N = scaler->kernel->size;
+    GLSLF("float nv12_weight_sum;\n{\n");
+    GLSLF("vec2 nv12_size = texture_size%d;\n", y_tex);
+    GLSLF("vec2 nv12_pt = pixel_size%d;\n", y_tex);
+    GLSLF("vec2 nv12_pos = texcoord%d;\n", y_tex);
+    GLSL(vec2 nv12_frac = fract(nv12_pos * nv12_size - vec2(0.5));)
+    GLSLF("vec2 nv12_base = nv12_pos - (nv12_frac + vec2(%d.0)) * nv12_pt;\n", N / 2 - 1);
+    GLSLF("vec2 nv12_uv_ratio = vec2(dFdx(texcoord%d.x) / dFdx(texcoord%d.x),\n"
+          " dFdy(texcoord%d.y) / dFdy(texcoord%d.y));\n", uv_tex, y_tex, uv_tex, y_tex);
+    GLSLF("float nv12_wx[%d], nv12_wy[%d];\n", N, N);
+    GLSL(float nv12_sx = 0.0;)
+    GLSL(float nv12_sy = 0.0;)
+    for (int axis = 0; axis < 2; axis++) {
+        char c = axis ? 'y' : 'x';
+        GLSLF("{ float fcoord = nv12_frac.%c; vec4 c;\n", c);
+        pass_sample_separated_get_weights(sc, scaler);
+        for (int n = 0; n < N; n++)
+            GLSLF("nv12_w%c[%d] = weights[%d]; nv12_s%c += weights[%d];\n", c, n, n, c, n);
+        GLSLF("}\n");
+    }
+    GLSL(nv12_weight_sum = nv12_sx * nv12_sy;)
+    GLSL(vec3 nv12_sum = vec3(0.0);)
+    GLSLF("for (int ny = 0; ny < %d; ny++) {\n", N);
+    GLSLF("for (int nx = 0; nx < %d; nx++) {\n", N);
+    GLSLF("vec2 q = clamp(nv12_base + vec2(nx, ny) * nv12_pt,\n"
+          " vec2(0.5) * nv12_pt, vec2(%d.5, %d.5) * nv12_pt);\n", valid_w - 1, valid_h - 1);
+    GLSLF("vec2 uvq = texcoord%d + (q - nv12_pos) * nv12_uv_ratio;\n", uv_tex);
+    GLSLF("float yy = texelFetch(texture%d, ivec2(q * nv12_size), 0).r * %.9f;\n", y_tex, y_mul);
+    GLSLF("vec2 uv = textureLod(texture%d, uvq, 0.0).rg * %.9f;\n", uv_tex, uv_mul);
+    GLSL(nv12_sum += nv12_wx[nx] * nv12_wy[ny] * vec3(yy, uv);)
+    GLSLF("}}\n");
+    GLSL(color = vec4(nv12_sum, 1.0);)
     GLSLF("}\n");
 }
 
