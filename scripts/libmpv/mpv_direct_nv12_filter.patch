+// Combine compatible NV12 planes with the existing filter LUT, without RGB FBOs.
+static bool pass_read_direct_nv12(struct gl_video *p, struct image img[4])
+{
+    enum pl_color_transfer trc = p->image_params.color.transfer;
+    bool standard_sdr = trc == PL_COLOR_TRC_BT_1886 || trc == PL_COLOR_TRC_SRGB ||
+                        trc == PL_COLOR_TRC_GAMMA22 || trc == PL_COLOR_TRC_GAMMA28;
+    if (!p->opts.direct_nv12 || p->ra->glsl_version < 130 ||
+        (p->opts.fbo_format && strcmp(p->opts.fbo_format, "auto")) ||
+        p->opts.dither_algo == DITHER_ERROR_DIFFUSION ||
+        p->has_alpha || !standard_sdr ||
+        p->image_params.color.primaries != PL_COLOR_PRIM_BT_709 ||
+        (p->image_params.repr.sys != PL_COLOR_SYSTEM_BT_709 &&
+         p->image_params.repr.sys != PL_COLOR_SYSTEM_BT_601) ||
+        p->ra_format.component_bits != 8 || strncmp(p->color_swizzle, "rgb", 3) ||
+        p->opts.linear_downscaling || p->opts.linear_upscaling ||
+        p->opts.sigmoid_upscaling || p->opts.interpolation || p->use_lut_3d ||
+        p->opts.deband || p->opts.unsharp || p->opts.blend_subs ||
+        (p->opts.user_shaders && p->opts.user_shaders[0]) ||
+        p->image_params.rotate || p->image_params.p_w != p->image_params.p_h ||
+        p->src_rect.x0 || p->src_rect.y0 ||
+        p->src_rect.x1 != p->image_params.w || p->src_rect.y1 != p->image_params.h ||
+        !gl_transform_eq(p->texture_offset, identity_trans) ||
+        p->opts.scaler[SCALER_CSCALE].kernel.function != SCALER_BILINEAR ||
+        img[0].type != PLANE_LUMA || img[0].components != 1 || img[0].padding ||
+        img[1].type != PLANE_CHROMA || img[1].components != 2 || img[1].padding ||
+        img[2].type != PLANE_NONE || img[3].type != PLANE_NONE)
+        return false;
+    for (int n = 0; n < 2; n++) {
+        if (!img[n].tex || img[n].tex->params.dimensions != 2 ||
+            img[n].tex->params.non_normalized ||
+            img[n].tex->params.format->ctype != RA_CTYPE_UNORM ||
+            strcmp(get_tex_swizzle(&img[n]), "rgba") ||
+            img[n].transform.m[0][1] || img[n].transform.m[1][0] ||
+            img[n].transform.m[0][0] <= 0 || img[n].transform.m[1][1] <= 0)
+            return false;
+    }
+    double xy[2];
+    get_scale_factors(p, true, xy);
+    bool down = xy[0] < 1.0 - FLT_EPSILON || xy[1] < 1.0 - FLT_EPSILON;
+    bool up = !down && (xy[0] > 1.0 + FLT_EPSILON || xy[1] > 1.0 + FLT_EPSILON);
+    int index = down && p->opts.scaler[SCALER_DSCALE].kernel.function != SCALER_INHERIT
+              ? SCALER_DSCALE : SCALER_SCALE;
+    struct scaler_config conf = p->opts.scaler[index];
+    if (p->opts.scaler_resizes_only && !down && !up)
+        return false;
+    if (conf.antiring || conf.clamp)
+        return false;
+    double f = MPMAX(xy[0], xy[1]);
+    if (!(f > 0))
+        return false;
+    double factor = p->opts.correct_downscaling && f < 1.0 ? 1.0 / f : 1.0;
+    struct scaler *scaler = &p->scaler[index];
+    reinit_scaler(p, scaler, &conf, factor, filter_sizes);
+    if (!scaler->kernel || scaler->kernel->polar || scaler->insufficient ||
+        scaler->kernel->size < 2 || scaler->kernel->size > 8)
+        return false;
+    int y = pass_bind(p, img[0]);
+    int uv = pass_bind(p, img[1]);
+    pass_sample_nv12_2d(p->sc, scaler, y, uv, p->image_params.w,
+                        p->image_params.h, img[0].multiplier, img[1].multiplier);
+    pass_describe(p, "direct NV12 %s (%dx%d)",
+        m_opt_choice_str(conf.kernel.functions, conf.kernel.function),
+        scaler->kernel->size, scaler->kernel->size);
+    // A previous fallback frame may have allocated full-sized RGB targets.
+    // None is bound by this guarded two-plane path; retire them on re-entry.
+    ra_tex_free(p->ra, &p->indirect_tex);
+    for (int n = 0; n < SCALER_COUNT; n++)
+        ra_tex_free(p->ra, &p->scaler[n].sep_fbo);
+    for (int n = 0; n < 4; n++)
+        ra_tex_free(p->ra, &p->scale_tex[n]);
+    p->direct_scale = true;
+    return true;
+}
