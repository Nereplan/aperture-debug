{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApertureStaticAnalysisBaseline",
  "description": "Schema for MSVC C++17 native static analysis warning baseline",
  "type": "object",
  "required": [
    "version",
    "description",
    "maxTotalWarnings",
    "allowedFingerprints"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "maxTotalWarnings": {
      "type": "integer",
      "minimum": 0
    },
    "allowedFingerprints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "code",
          "message",
          "maxOccurrences"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^C[0-9]+$"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "maxOccurrences": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}