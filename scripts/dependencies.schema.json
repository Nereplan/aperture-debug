{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApertureDependencyManifest",
  "description": "Schema for authoritative inventory of Aperture build, runtime, test, and package dependencies",
  "type": "object",
  "required": [
    "version",
    "toolchain",
    "vendoredFiles",
    "runtimePackageDependencies",
    "ciActions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "toolchain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "license",
          "source"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string", "enum": ["required", "optional", "ci_and_tests", "user_discovered"] },
          "minimumVersion": { "type": "string" },
          "standard": { "type": "string" },
          "architecture": { "type": "string" },
          "executable": { "type": "string" },
          "discoveryPolicy": { "type": "string" },
          "license": { "type": "string" },
          "source": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "vendoredFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "path",
          "category",
          "sha256",
          "size",
          "license",
          "source"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "category": { "type": "string", "enum": ["required", "optional"] },
          "version": { "type": "string" },
          "abiVersion": { "type": "string" },
          "clientApiVersion": { "type": "string" },
          "architecture": { "type": "string" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "license": { "type": "string" },
          "source": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "runtimePackageDependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "fileName",
          "resolution",
          "license",
          "source"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "fileName": { "type": "string" },
          "architecture": { "type": "string" },
          "resolution": { "type": "array", "items": { "type": "string" } },
          "license": { "type": "string" },
          "source": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "ciActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "version",
          "license",
          "source"
        ],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "version": { "type": "string" },
          "license": { "type": "string" },
          "source": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
