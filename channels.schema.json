{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApertureChannelPolicy",
  "description": "Authoritative machine-readable release channel policy defining names, precedence, version eligibility, prerelease rules, manifest trust provisioning, retention/cadence metadata, and user-facing labels",
  "type": "object",
  "required": [
    "schemaVersion",
    "defaultChannel",
    "channels"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "defaultChannel": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "description",
          "stabilityRank",
          "acceptedChannels",
          "prerelease",
          "retentionDays",
          "maxExpiryDays",
          "updateCadenceDays",
          "allowDowngrade",
          "requiresPinnedTrust"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "stabilityRank": { "type": "integer", "minimum": 0 },
          "acceptedChannels": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          },
          "prerelease": {
            "type": "object",
            "required": [
              "allowed",
              "prefix",
              "pattern",
              "requireNumericSequence"
            ],
            "properties": {
              "allowed": { "type": "boolean" },
              "prefix": { "type": "string" },
              "pattern": { "type": "string" },
              "requireNumericSequence": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "retentionDays": { "type": "integer", "minimum": 1 },
          "maxExpiryDays": { "type": "integer", "minimum": 1 },
          "updateCadenceDays": { "type": "integer", "minimum": 1 },
          "allowDowngrade": { "type": "boolean" },
          "requiresPinnedTrust": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
