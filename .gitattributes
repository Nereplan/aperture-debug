* text=auto
*.cpp text eol=lf
*.h text eol=lf
*.in text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.sh text eol=lf
*.cmd text eol=crlf
*.dll binary
*.ttf binary
*.ico binary
*.png binary

