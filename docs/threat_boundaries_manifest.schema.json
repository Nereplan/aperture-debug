{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApertureThreatBoundariesManifest",
  "description": "Authoritative machine-readable manifest of Aperture threat boundaries, trust levels, entry points, bounds, and test verifications",
  "type": "object",
  "required": [
    "$schema",
    "version",
    "description",
    "containmentPolicy",
    "boundaries"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1 },
    "containmentPolicy": {
      "type": "object",
      "required": [
        "mode",
        "durableStateRoot",
        "disposableCacheRoot",
        "diagnosticsRoot",
        "prohibitedExternalLocations"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["portable_only"] },
        "durableStateRoot": { "type": "string" },
        "disposableCacheRoot": { "type": "string" },
        "diagnosticsRoot": { "type": "string" },
        "prohibitedExternalLocations": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "trustLevel",
          "privilegeContext",
          "durableWriteDestination",
          "failureErrorCode",
          "authoritativeSymbols",
          "sourceFiles",
          "testFiles",
          "validationRules",
          "residualRiskSummary"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "trustLevel": { "type": "string", "minLength": 1 },
          "privilegeContext": { "type": "string", "minLength": 1 },
          "durableWriteDestination": { "type": "string", "minLength": 1 },
          "failureErrorCode": { "type": "string", "minLength": 1 },
          "authoritativeSymbols": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "sourceFiles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "testFiles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "validationRules": {
            "type": "object",
            "minProperties": 1
          },
          "residualRiskSummary": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
